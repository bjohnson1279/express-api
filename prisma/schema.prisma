generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(255)
  businessHours        Json?                 @map("business_hours")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @map("updated_at")
  users                User[]
  jobs                 Job[]
  routes               Route[]
  trainingCourses      TrainingCourse[]
  canvassPins          CanvassPin[]
  commissions          Commission[]
  serviceContracts     ServiceContract[]
  contactLogs          ContactLog[]
  internalNotes        InternalNote[]
  onboardingChecklists OnboardingChecklist[]
  notificationQueue    NotificationQueue[]
  agreements           ServiceAgreement[]
  Campaign             Campaign[]
  AutomatedFollowup    AutomatedFollowup[]
  InventoryItem        InventoryItem[]
  PurchaseOrder        PurchaseOrder[]
  territories          Territory[]
  doNotKnockRecords    DoNotKnockRecord[]
  chatConversations    ChatConversation[]
  chatMessages         ChatMessage[]
  cannedResponses      CannedResponse[]
  pestRiskScores       PropertyPestRiskScore[]

  @@map("tenants")
}

enum Role {
  SUPER_ADMIN
  DISPATCHER
  TECHNICIAN
  CUSTOMER
  DOOR_TO_DOOR_SALES
  CUSTOMER_SERVICE_REP
  MANAGER

  @@map("user_role")
}

model User {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  email           String                   @unique @db.VarChar(255)
  passwordHash    String                   @map("password_hash") @db.VarChar(255)
  role            Role
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @map("updated_at")
  technician      Technician?
  customer        Customer?
  notifications   Notification[]
  certifications  EmployeeCertification[]
  canvassPins     CanvassPin[]
  commissions     Commission[]
  contactLogs     ContactLog[]
  internalNotes   InternalNote[]
  onboardingTasks     EmployeeOnboardingTask[]
  documents           EmployeeDocument[]
  assignedTerritories Territory[]              @relation("RepTerritories")
  assignedChatConversations ChatConversation[] @relation("CsrConversations")

  @@map("users")
}

model TrainingCourse {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  title          String                  @db.VarChar(255)
  description    String?                 @db.Text
  isMandatory    Boolean                 @default(false) @map("is_mandatory")
  validityMonths Int?                    @map("validity_months")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @default(now()) @map("updated_at")
  certifications EmployeeCertification[]

  @@map("training_courses")
}

model EmployeeCertification {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id])
  courseId    String         @map("course_id") @db.Uuid
  course      TrainingCourse @relation(fields: [courseId], references: [id])
  completedAt DateTime?      @map("completed_at")
  expiresAt   DateTime?      @map("expires_at")
  status      String         @default("active") @db.VarChar(50)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("employee_certifications")
}

enum TechStatus {
  available
  en_route
  on_site
  off_duty

  @@map("tech_status")
}

model Technician {
  id                 String                          @id @default(uuid()) @db.Uuid
  userId             String                          @unique @map("user_id") @db.Uuid
  user               User                            @relation(fields: [userId], references: [id])
  skills             Json?
  status             TechStatus                      @default(off_duty)
  currentLocationLat Decimal?                        @map("current_location_lat") @db.Decimal(10, 7)
  currentLocationLng Decimal?                        @map("current_location_lng") @db.Decimal(10, 7)
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @default(now()) @map("updated_at")
  jobs               Job[]
  routes             Route[]
  restrictions       CustomerTechnicianRestriction[]
  chemicalLogs       ChemicalApplicationLog[]

  @@map("technicians")
}

model Customer {
  id                 String                          @id @default(uuid()) @db.Uuid
  userId             String                          @unique @map("user_id") @db.Uuid
  user               User                            @relation(fields: [userId], references: [id])
  name               String                          @db.VarChar(255)
  billingPreferences Json?                           @map("billing_preferences")
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @default(now()) @map("updated_at")
  properties         Property[]
  jobs               Job[]
  restrictions       CustomerTechnicianRestriction[]
  contracts          ServiceContract[]
  contactLogs        ContactLog[]
  internalNotes      InternalNote[]
  phones             CustomerPhone[]
  emails             CustomerEmail[]
  notificationQueue  NotificationQueue[]
  quotes             Quote[]
  payments           Payment[]
  healthScore        CustomerHealthScore?
  agreements         ServiceAgreement[]
  AutomatedFollowup  AutomatedFollowup[]
  chatConversations  ChatConversation[]

  @@map("customers")
}

model CustomerTechnicianRestriction {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  customer     Customer   @relation(fields: [customerId], references: [id])
  technicianId String     @map("technician_id") @db.Uuid
  technician   Technician @relation(fields: [technicianId], references: [id])
  reason       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([customerId, technicianId])
  @@map("customer_technician_restrictions")
}

model Property {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  customer      Customer           @relation(fields: [customerId], references: [id])
  address       String             @db.VarChar(255)
  city          String?            @db.VarChar(100)
  state         String?            @db.VarChar(100)
  zipCode       String?            @map("zip_code") @db.VarChar(20)
  lat           Decimal?           @default(39.7817) @db.Decimal(10, 7)
  lng           Decimal?           @default(-89.6501) @db.Decimal(10, 7)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @map("updated_at")
  jobs          Job[]
  contracts     ServiceContract[]
  internalNotes InternalNote[]
  quotes        Quote[]
  agreements    ServiceAgreement[]
  photos        PropertyPhoto[]
  pestRiskScores PropertyPestRiskScore[]

  @@map("properties")
}

enum ContractCadence {
  ONE_TIME
  MONTHLY
  BI_MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY

  @@map("contract_cadence")
}

model ServiceContract {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  customerId      String             @map("customer_id") @db.Uuid
  customer        Customer           @relation(fields: [customerId], references: [id])
  propertyId      String             @map("property_id") @db.Uuid
  property        Property           @relation(fields: [propertyId], references: [id])
  cadence         ContractCadence
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime?          @map("end_date") @db.Date
  autoRenew       Boolean            @default(true) @map("auto_renew")
  recurringAmount Decimal?           @map("recurring_amount") @db.Decimal(10, 2)
  status          String             @default("active") @db.VarChar(50)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @default(now()) @map("updated_at")
  jobs            Job[]
  agreements      ServiceAgreement[]

  @@map("service_contracts")
}

enum JobStatus {
  draft
  scheduled
  in_progress
  completed
  invoiced
  cancelled

  @@map("job_status")
}

model Job {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  customerId        String                   @map("customer_id") @db.Uuid
  customer          Customer                 @relation(fields: [customerId], references: [id])
  propertyId        String                   @map("property_id") @db.Uuid
  property          Property                 @relation(fields: [propertyId], references: [id])
  technicianId      String?                  @map("technician_id") @db.Uuid
  technician        Technician?              @relation(fields: [technicianId], references: [id])
  contractId        String?                  @map("contract_id") @db.Uuid
  contract          ServiceContract?         @relation(fields: [contractId], references: [id])
  status            JobStatus                @default(draft)
  scheduledStart    DateTime?                @map("scheduled_start")
  scheduledEnd      DateTime?                @map("scheduled_end")
  requiredSkills    Json?                    @map("required_skills")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @default(now()) @map("updated_at")
  invoices          Invoice[]
  commissions       Commission[]
  chemicalLogs      ChemicalApplicationLog[]
  notificationQueue NotificationQueue[]
  photos            PropertyPhoto[]

  @@map("jobs")
}

model ChemicalApplicationLog {
  id                String     @id @default(uuid()) @db.Uuid
  jobId             String     @map("job_id") @db.Uuid
  job               Job        @relation(fields: [jobId], references: [id])
  technicianId      String     @map("technician_id") @db.Uuid
  technician        Technician @relation(fields: [technicianId], references: [id])
  chemicalName      String     @map("chemical_name") @db.VarChar(255)
  quantityUsed      Decimal    @map("quantity_used") @db.Decimal(10, 2)
  unit              String     @db.VarChar(50)
  targetPests       Json?      @map("target_pests")
  weatherConditions Json?      @map("weather_conditions")
  appliedAt         DateTime       @default(now()) @map("applied_at")
  photoUrl          String?        @map("photo_url")
  inventoryItemId   String?        @map("inventory_item_id") @db.Uuid
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  epaRegistrationNo String?        @map("epa_registration_no") @db.VarChar(100)

  @@map("chemical_application_logs")
}

model Route {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  technicianId String     @map("technician_id") @db.Uuid
  technician   Technician @relation(fields: [technicianId], references: [id])
  manifest     Json
  date         DateTime   @db.Date
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @map("updated_at")

  @@map("routes")
}

model Invoice {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  job         Job       @relation(fields: [jobId], references: [id])
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  status      String    @default("unpaid") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  payments    Payment[]

  @@map("invoices")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  type      String    @db.VarChar(50)
  channel   String    @db.VarChar(50)
  content   String
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

enum LeadStatus {
  NOT_HOME
  NOT_INTERESTED
  PITCHED
  SOLD

  @@map("lead_status")
}

model CanvassPin {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  salesRepId   String      @map("sales_rep_id") @db.Uuid
  salesRep     User        @relation(fields: [salesRepId], references: [id])
  territoryId  String?     @map("territory_id") @db.Uuid
  territory    Territory?  @relation(fields: [territoryId], references: [id])
  isDoNotKnock Boolean     @default(false) @map("is_do_not_knock")
  lat          Decimal     @db.Decimal(10, 7)
  lng          Decimal     @db.Decimal(10, 7)
  address      String?     @db.VarChar(255)
  status       LeadStatus
  notes        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @map("updated_at")

  @@map("canvass_pins")
}

model Commission {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  salesRepId     String   @map("sales_rep_id") @db.Uuid
  salesRep       User     @relation(fields: [salesRepId], references: [id])
  jobId          String?  @map("job_id") @db.Uuid
  job            Job?     @relation(fields: [jobId], references: [id])
  amount         Decimal  @db.Decimal(10, 2)
  type           String   @db.VarChar(50)
  isClawedBack   Boolean  @default(false) @map("is_clawed_back")
  clawbackReason String?  @map("clawback_reason") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("commissions")
}

model ContactLog {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  customerId             String   @map("customer_id") @db.Uuid
  customer               Customer @relation(fields: [customerId], references: [id])
  userId                 String?  @map("user_id") @db.Uuid
  user                   User?    @relation(fields: [userId], references: [id])
  channel                String   @db.VarChar(50)
  direction              String   @db.VarChar(50)
  summary                String?  @db.Text
  chronologicalTimestamp DateTime @default(now()) @map("chronological_timestamp")

  @@map("contact_logs")
}

model InternalNote {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  propertyId String?   @map("property_id") @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])
  authorId   String    @map("author_id") @db.Uuid
  author     User      @relation(fields: [authorId], references: [id])
  isPinned   Boolean   @default(false) @map("is_pinned")
  noteText   String    @map("note_text") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")

  @@map("internal_notes")
}

model OnboardingChecklist {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  role             Role
  taskName         String                   @map("task_name") @db.VarChar(255)
  description      String?                  @db.Text
  requiresDocument Boolean                  @default(false) @map("requires_document")
  createdAt        DateTime                 @default(now()) @map("created_at")
  tasks            EmployeeOnboardingTask[]

  @@map("onboarding_checklists")
}

model EmployeeOnboardingTask {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id])
  checklistId String              @map("checklist_id") @db.Uuid
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id])
  status      String              @default("pending") @db.VarChar(50)
  completedAt DateTime?           @map("completed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  documents   EmployeeDocument[]

  @@map("employee_onboarding_tasks")
}

model EmployeeDocument {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  user         User                    @relation(fields: [userId], references: [id])
  taskId       String?                 @map("task_id") @db.Uuid
  task         EmployeeOnboardingTask? @relation(fields: [taskId], references: [id])
  documentType String                  @map("document_type") @db.VarChar(100)
  filePath     String                  @map("file_path") @db.Text
  uploadedAt   DateTime                @default(now()) @map("uploaded_at")

  @@map("employee_documents")
}

model CustomerPhone {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id])
  phoneNumber String   @map("phone_number") @db.VarChar(20)
  type        String   @db.VarChar(50)
  isPrimary   Boolean  @default(false) @map("is_primary")
  receivesSms Boolean  @default(false) @map("receives_sms")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("customer_phones")
}

model CustomerEmail {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  emailAddress String   @map("email_address") @db.VarChar(255)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("customer_emails")
}

model NotificationQueue {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  customerId     String    @map("customer_id") @db.Uuid
  customer       Customer  @relation(fields: [customerId], references: [id])
  jobId          String?   @map("job_id") @db.Uuid
  job            Job?      @relation(fields: [jobId], references: [id])
  channel        String    @db.VarChar(50)
  contactTarget  String    @map("contact_target") @db.VarChar(255)
  messageContent String    @map("message_content") @db.Text
  status         String    @default("pending") @db.VarChar(50)
  errorLog       String?   @map("error_log") @db.Text
  scheduledFor   DateTime  @default(now()) @map("scheduled_for")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("notification_queue")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected

  @@map("quote_status")
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  customer    Customer    @relation(fields: [customerId], references: [id])
  propertyId  String      @map("property_id") @db.Uuid
  property    Property    @relation(fields: [propertyId], references: [id])
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  status      QuoteStatus @default(draft)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @map("updated_at")

  @@map("quotes")
}

enum PaymentMethod {
  credit_card
  cash
  check
  ach

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  completed
  failed

  @@map("payment_status")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  invoiceId             String?       @map("invoice_id") @db.Uuid
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id])
  customerId            String        @map("customer_id") @db.Uuid
  customer              Customer      @relation(fields: [customerId], references: [id])
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  externalTransactionId String?       @map("external_transaction_id") @db.VarChar(255)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @map("updated_at")

  @@map("payments")
}

enum ErpProvider {
  quickbooks
  xero
  netsuite

  @@map("erp_provider")
}

model ErpSyncLog {
  id            String      @id @default(uuid()) @db.Uuid
  provider      ErpProvider
  resourceType  String      @map("resource_type") @db.VarChar(50)
  resourceId    String      @map("resource_id") @db.Uuid
  status        String      @db.VarChar(50)
  errorMessage  String?     @map("error_message") @db.Text
  syncTimestamp DateTime    @default(now()) @map("sync_timestamp")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("erp_sync_logs")
}

model CustomerHealthScore {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @unique @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  score        Int
  riskLevel    String   @map("risk_level") @db.VarChar(50)
  factors      Json?
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@map("customer_health_scores")
}

enum AgreementStatus {
  draft
  sent
  signed
  cancelled

  @@map("agreement_status")
}

model ServiceAgreement {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  customerId      String           @map("customer_id") @db.Uuid
  customer        Customer         @relation(fields: [customerId], references: [id])
  propertyId      String           @map("property_id") @db.Uuid
  property        Property         @relation(fields: [propertyId], references: [id])
  status          AgreementStatus  @default(draft)
  cadence         ContractCadence
  recurringAmount Decimal          @map("recurring_amount") @db.Decimal(10, 2)
  startDate       DateTime         @map("start_date") @db.Date
  pdfUrl          String?          @map("pdf_url") @db.Text
  signatureSvg    String?          @map("signature_svg") @db.Text
  signedAt        DateTime?        @map("signed_at")
  contractId      String?          @map("contract_id") @db.Uuid
  contract        ServiceContract? @relation(fields: [contractId], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @map("updated_at")

  @@map("service_agreements")
}

model PropertyPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  jobId      String?  @map("job_id") @db.Uuid
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  url        String   @db.VarChar(2048)
  caption    String?  @db.Text
  tags       Json?
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("property_photos")
}

model Campaign {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  name      String              @db.VarChar(255)
  status    String              @default("draft") @db.VarChar(50)
  startDate DateTime?           @map("start_date") @db.Date
  endDate   DateTime?           @map("end_date") @db.Date
  budget    Decimal?            @db.Decimal(10, 2)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @map("updated_at")
  followups AutomatedFollowup[]

  @@map("campaigns")
}

model AutomatedFollowup {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  customerId    String    @map("customer_id") @db.Uuid
  customer      Customer  @relation(fields: [customerId], references: [id])
  campaignId    String?   @map("campaign_id") @db.Uuid
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  sequenceType  String    @map("sequence_type") @db.VarChar(100)
  scheduledDate DateTime  @map("scheduled_date")
  sentStatus    String    @default("pending") @map("sent_status") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  @@map("automated_followups")
}

model InventoryItem {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  name             String          @db.VarChar(255)
  sku              String          @db.VarChar(100)
  quantity         Int             @default(0)
  minimumThreshold Int             @default(10) @map("minimum_threshold")
  unitCost         Decimal?        @map("unit_cost") @db.Decimal(10, 2)
  location         String?         @db.VarChar(255)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @map("updated_at")
  purchaseOrders   PurchaseOrder[]
  chemicalLogs     ChemicalApplicationLog[]

  @@map("inventory_items")
}

model PurchaseOrder {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  itemId               String        @map("item_id") @db.Uuid
  item                 InventoryItem @relation(fields: [itemId], references: [id])
  quantity             Int
  status               String        @default("draft") @db.VarChar(50)
  expectedDeliveryDate DateTime?     @map("expected_delivery_date") @db.Date
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @map("updated_at")

  @@map("purchase_orders")
}

model Territory {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  name               String             @db.VarChar(255)
  description        String?            @db.Text
  assignedRepId      String?            @map("assigned_rep_id") @db.Uuid
  assignedRep        User?              @relation("RepTerritories", fields: [assignedRepId], references: [id])
  color              String?            @default("#3b82f6") @db.VarChar(50)
  polygonCoordinates Json               @map("polygon_coordinates")
  quotaTarget        Decimal?           @default(0.00) @map("quota_target") @db.Decimal(10, 2)
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @map("updated_at")
  canvassPins        CanvassPin[]
  doNotKnockRecords  DoNotKnockRecord[]

  @@map("territories")
}

model DoNotKnockRecord {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  territoryId String?    @map("territory_id") @db.Uuid
  territory   Territory? @relation(fields: [territoryId], references: [id])
  address     String     @db.VarChar(255)
  lat         Decimal?   @db.Decimal(10, 7)
  lng         Decimal?   @db.Decimal(10, 7)
  reason      String?    @default("Customer Request") @db.VarChar(255)
  expiresAt   DateTime?  @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("do_not_knock_records")
}

model ChatConversation {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String        @map("customer_id") @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedCsrId String?       @map("assigned_csr_id") @db.Uuid
  assignedCsr   User?         @relation("CsrConversations", fields: [assignedCsrId], references: [id], onDelete: SetNull)
  status        String        @default("OPEN") @db.VarChar(50)
  subject       String?       @db.VarChar(255)
  lastMessageAt DateTime      @default(now()) @map("last_message_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @map("updated_at")
  messages      ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String           @map("sender_type") @db.VarChar(50)
  senderId       String?          @map("sender_id") @db.Uuid
  senderName     String?          @map("sender_name") @db.VarChar(255)
  messageText    String           @map("message_text") @db.Text
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("chat_messages")
}

model CannedResponse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shortcut  String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  category  String   @default("GENERAL") @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("canned_responses")
}

model PropertyPestRiskScore {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId                 String   @map("property_id") @db.Uuid
  property                   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  overallRiskScore           Int      @map("overall_risk_score")
  riskLevel                  String   @map("risk_level") @db.VarChar(50)
  primaryTargetPest          String   @map("primary_target_pest") @db.VarChar(100)
  resurgenceProbability      Decimal  @map("resurgence_probability") @db.Decimal(5, 2)
  daysToProjectedResurgence  Int      @map("days_to_projected_resurgence")
  weatherRiskFactor          Decimal  @default(1.00) @map("weather_risk_factor") @db.Decimal(5, 2)
  chemicalDecayFactor        Decimal  @default(1.00) @map("chemical_decay_factor") @db.Decimal(5, 2)
  seasonalVector             String   @map("seasonal_vector") @db.VarChar(50)
  recommendedTreatment       String   @map("recommended_treatment") @db.Text
  upsellRecommendation      String?  @map("upsell_recommendation") @db.Text
  calculatedAt               DateTime @default(now()) @map("calculated_at")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @default(now()) @map("updated_at")

  @@map("property_pest_risk_scores")
}


