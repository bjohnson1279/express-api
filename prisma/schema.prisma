generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  businessHours Json?    @map("business_hours")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")
  users         User[]
  jobs          Job[]
  routes        Route[]
  trainingCourses TrainingCourse[]
  canvassPins   CanvassPin[]
  commissions   Commission[]
  serviceContracts ServiceContract[]
  contactLogs   ContactLog[]
  internalNotes InternalNote[]

  @@map("tenants")
}

enum Role {
  SUPER_ADMIN
  DISPATCHER
  TECHNICIAN
  CUSTOMER
  DOOR_TO_DOOR_SALES
  CUSTOMER_SERVICE_REP
  MANAGER

  @@map("user_role")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  email        String         @unique @db.VarChar(255)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  role         Role
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @map("updated_at")
  technician   Technician?
  customer     Customer?
  notifications Notification[]
  certifications EmployeeCertification[]
  canvassPins  CanvassPin[]
  commissions  Commission[]
  contactLogs  ContactLog[]
  internalNotes InternalNote[]

  @@map("users")
}

model TrainingCourse {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  isMandatory     Boolean  @default(false) @map("is_mandatory")
  validityMonths  Int?     @map("validity_months")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")
  certifications  EmployeeCertification[]

  @@map("training_courses")
}

model EmployeeCertification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  courseId    String   @map("course_id") @db.Uuid
  course      TrainingCourse @relation(fields: [courseId], references: [id])
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @map("expires_at")
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("employee_certifications")
}

enum TechStatus {
  available
  en_route
  on_site
  off_duty

  @@map("tech_status")
}

model Technician {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @unique @map("user_id") @db.Uuid
  user               User       @relation(fields: [userId], references: [id])
  skills             Json?
  status             TechStatus @default(off_duty)
  currentLocationLat Decimal?   @map("current_location_lat") @db.Decimal(10, 7)
  currentLocationLng Decimal?   @map("current_location_lng") @db.Decimal(10, 7)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @map("updated_at")
  jobs               Job[]
  routes             Route[]
  restrictions       CustomerTechnicianRestriction[]
  chemicalLogs       ChemicalApplicationLog[]

  @@map("technicians")
}

model Customer {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @unique @map("user_id") @db.Uuid
  user               User       @relation(fields: [userId], references: [id])
  name               String     @db.VarChar(255)
  billingPreferences Json?      @map("billing_preferences")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @map("updated_at")
  properties         Property[]
  jobs               Job[]
  restrictions       CustomerTechnicianRestriction[]
  contracts          ServiceContract[]
  contactLogs        ContactLog[]
  internalNotes      InternalNote[]

  @@map("customers")
}

model CustomerTechnicianRestriction {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  customer     Customer   @relation(fields: [customerId], references: [id])
  technicianId String     @map("technician_id") @db.Uuid
  technician   Technician @relation(fields: [technicianId], references: [id])
  reason       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([customerId, technicianId])
  @@map("customer_technician_restrictions")
}

model Property {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  address    String   @db.VarChar(255)
  city       String?  @db.VarChar(100)
  state      String?  @db.VarChar(100)
  zipCode    String?  @map("zip_code") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")
  jobs       Job[]
  contracts  ServiceContract[]
  internalNotes InternalNote[]

  @@map("properties")
}

enum ContractCadence {
  ONE_TIME
  MONTHLY
  BI_MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY

  @@map("contract_cadence")
}

model ServiceContract {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  customerId      String   @map("customer_id") @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id])
  propertyId      String   @map("property_id") @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id])
  cadence         ContractCadence
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  autoRenew       Boolean  @default(true) @map("auto_renew")
  recurringAmount Decimal? @map("recurring_amount") @db.Decimal(10, 2)
  status          String   @default("active") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")
  jobs            Job[]

  @@map("service_contracts")
}

enum JobStatus {
  draft
  scheduled
  in_progress
  completed
  invoiced
  cancelled

  @@map("job_status")
}

model Job {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  customerId     String      @map("customer_id") @db.Uuid
  customer       Customer    @relation(fields: [customerId], references: [id])
  propertyId     String      @map("property_id") @db.Uuid
  property       Property    @relation(fields: [propertyId], references: [id])
  technicianId   String?     @map("technician_id") @db.Uuid
  technician     Technician? @relation(fields: [technicianId], references: [id])
  contractId     String?     @map("contract_id") @db.Uuid
  contract       ServiceContract? @relation(fields: [contractId], references: [id])
  status         JobStatus   @default(draft)
  scheduledStart DateTime?   @map("scheduled_start")
  scheduledEnd   DateTime?   @map("scheduled_end")
  requiredSkills Json?       @map("required_skills")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @map("updated_at")
  invoices       Invoice[]
  commissions    Commission[]
  chemicalLogs   ChemicalApplicationLog[]

  @@map("jobs")
}

model ChemicalApplicationLog {
  id                String   @id @default(uuid()) @db.Uuid
  jobId             String   @map("job_id") @db.Uuid
  job               Job      @relation(fields: [jobId], references: [id])
  technicianId      String   @map("technician_id") @db.Uuid
  technician        Technician @relation(fields: [technicianId], references: [id])
  chemicalName      String   @map("chemical_name") @db.VarChar(255)
  quantityUsed      Decimal  @map("quantity_used") @db.Decimal(10, 2)
  unit              String   @db.VarChar(50)
  targetPests       Json?    @map("target_pests")
  weatherConditions Json?    @map("weather_conditions")
  appliedAt         DateTime @default(now()) @map("applied_at")

  @@map("chemical_application_logs")
}

model Route {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  technicianId String     @map("technician_id") @db.Uuid
  technician   Technician @relation(fields: [technicianId], references: [id])
  manifest     Json
  date         DateTime   @db.Date
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @map("updated_at")

  @@map("routes")
}

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  job         Job      @relation(fields: [jobId], references: [id])
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  status      String   @default("unpaid") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("invoices")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  type      String    @db.VarChar(50)
  channel   String    @db.VarChar(50)
  content   String
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

enum LeadStatus {
  NOT_HOME
  NOT_INTERESTED
  PITCHED
  SOLD

  @@map("lead_status")
}

model CanvassPin {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  salesRepId String   @map("sales_rep_id") @db.Uuid
  salesRep   User     @relation(fields: [salesRepId], references: [id])
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  address    String?  @db.VarChar(255)
  status     LeadStatus
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("canvass_pins")
}

model Commission {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  salesRepId     String   @map("sales_rep_id") @db.Uuid
  salesRep       User     @relation(fields: [salesRepId], references: [id])
  jobId          String?  @map("job_id") @db.Uuid
  job            Job?     @relation(fields: [jobId], references: [id])
  amount         Decimal  @db.Decimal(10, 2)
  type           String   @db.VarChar(50)
  isClawedBack   Boolean  @default(false) @map("is_clawed_back")
  clawbackReason String?  @map("clawback_reason") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("commissions")
}

model ContactLog {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  customerId             String   @map("customer_id") @db.Uuid
  customer               Customer @relation(fields: [customerId], references: [id])
  userId                 String?  @map("user_id") @db.Uuid
  user                   User?    @relation(fields: [userId], references: [id])
  channel                String   @db.VarChar(50)
  direction              String   @db.VarChar(50)
  summary                String?  @db.Text
  chronologicalTimestamp DateTime @default(now()) @map("chronological_timestamp")

  @@map("contact_logs")
}

model InternalNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  propertyId String?  @map("property_id") @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id])
  authorId   String   @map("author_id") @db.Uuid
  author     User     @relation(fields: [authorId], references: [id])
  isPinned   Boolean  @default(false) @map("is_pinned")
  noteText   String   @map("note_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("internal_notes")
}
